{
  "name": "astn-runtime",
  "version": "0.1.1",
  "author": "Corno",
  "license": "Apache-2.0",
  "description": "The TypeScript runtime library for parsing and formatting ASTN (Abstract Syntax Tree Notation) - a human-editable data format for structured content",
  "keywords": [
    "astn",
    "parser",
    "formatter",
    "abstract-syntax-tree",
    "data-format",
    "typescript",
    "lexer",
    "structured-data",
    "configuration",
    "serialization"
  ],
  "homepage": "https://github.com/corno/astn-runtime#readme",
  "bugs": {
    "url": "https://github.com/corno/astn-runtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corno/astn-runtime.git"
  },
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "documentation"
  ],
  "dependencies": {
    "pareto-core": "^0.1.320",
    "pareto-fountain-pen": "^0.4.0"
  }
}
